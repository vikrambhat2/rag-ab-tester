# The built-in provider is any OpenAI-compatible endpoint (OpenAI, Ollama, vLLM, LiteLLM,
# gateways, ...). To use anything else (Anthropic, Bedrock, Chroma, pgvector, ...), call the
# SDK and pass your own objects: run_experiment(..., llm=, embedder=, index_factory=).

# ── Generator: the model that answers questions (required) ────────────────── #
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-api-key
# Leave unset for OpenAI itself; set for any other server, e.g. local Ollama:
# LLM_BASE_URL=http://localhost:11434/v1     # LLM_API_KEY may then be omitted

# ── Embeddings (required by the built-in experiments) ─────────────────────── #
EMBED_MODEL=text-embedding-3-small
# Defaults to the LLM_BASE_URL / LLM_API_KEY above; override if embeddings live elsewhere.
# EMBED_BASE_URL=https://your-endpoint/v1
# EMBED_API_KEY=...
# The built-in embedding experiment compares EMBED_MODEL against this model:
# EMBED_MODEL_CHALLENGER=text-embedding-3-large

# ── Separate judge (recommended) ──────────────────────────────────────────── #
# By default the judge is the same model as the generator, which can bias
# LLM-as-judge scores. Unset values fall back to the generator settings. A judge on a
# different JUDGE_LLM_BASE_URL never inherits the generator's API key.
# JUDGE_LLM_MODEL=a-different-model
# JUDGE_LLM_BASE_URL=https://your-endpoint/v1
# JUDGE_LLM_API_KEY=...

# ── Tuning (optional) ─────────────────────────────────────────────────────── #
# LLM_TIMEOUT=120         # seconds per request
# LOG_LEVEL=INFO
