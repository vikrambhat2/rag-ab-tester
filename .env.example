# ── WatsonX AI (required) ─────────────────────────────────────────────────── #
WATSONX_API_KEY=your-ibm-cloud-api-key
WATSONX_PROJECT_ID=your-watsonx-project-id
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# WatsonX model overrides (optional)
# WATSONX_LLM_MODEL_ID=ibm/granite-3-8b-instruct
# WATSONX_EMBED_MODEL_ID=ibm/slate-125m-english-rtrvr-v2

# ── OpenSearch (required) ─────────────────────────────────────────────────── #
OPENSEARCH_URL=https://your-opensearch-host:9200
OPENSEARCH_USERNAME=your-username
OPENSEARCH_PASSWORD=your-password
# Set to false ONLY for local development with self-signed certificates.
OPENSEARCH_VERIFY_SSL=true

# ── Chat LLM provider (optional) ──────────────────────────────────────────── #
# Default: WatsonX (langchain-ibm) using WATSONX_LLM_MODEL_ID above.
# To use any OpenAI-compatible endpoint (watsonx.ai Model Gateway, vLLM, OpenAI, ...):
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://your-endpoint/v1
# LLM_API_KEY=...
# LLM_MODEL=model-name
# Embeddings are ALWAYS WatsonX, so WATSONX_* is still required for experiments.

# ── Separate judge (recommended) ──────────────────────────────────────────── #
# By default the judge is the same model as the generator, which can bias
# LLM-as-judge scores. Unset values fall back to the generator settings.
# JUDGE_LLM_PROVIDER=openai
# JUDGE_LLM_BASE_URL=https://your-endpoint/v1
# JUDGE_LLM_API_KEY=...
# JUDGE_LLM_MODEL=a-different-model

# ── Tuning (optional) ─────────────────────────────────────────────────────── #
# OPENSEARCH_TIMEOUT=60   # seconds
# LLM_TIMEOUT=120         # seconds per request (OpenAI-compatible provider)
# LOG_LEVEL=INFO
